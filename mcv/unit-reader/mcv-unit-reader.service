[Unit]
Description=MCV train allocation reader
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/mcv-unit-reader
ExecStart=/opt/mcv-unit-reader/.venv/bin/python -u /opt/mcv-unit-reader/reader.py
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
