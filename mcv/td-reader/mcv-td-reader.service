[Unit]
Description=MCV train describer raw capture
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mcv-td-reader
ExecStart=/opt/mcv-unit-reader/.venv/bin/python -u /opt/mcv-td-reader/td_reader.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/mcv-td-reader
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
